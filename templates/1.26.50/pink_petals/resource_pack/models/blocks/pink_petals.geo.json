{
  "format_version": "1.26.50",
  "minecraft:geometry": [
    {
      "description": {
        "identifier": "geometry.kai_templates_pink_petals",
        "texture_width": 16,
        "texture_height": 16,
        "visible_bounds_width": 2,
        "visible_bounds_height": 1,
        "visible_bounds_offset": [0, 0.5, 0]
      },
      // One bone per petal, in the order vanilla fills the block: north-west first, then south-west, south-east and north-east. Each bone is a flat flower box lifted off the floor and the plus-shaped stem holding it up. The X coordinates are mirrored against the Java model, because block geometry draws model -X on the world east side.
      "bones": [
        {
          // Each flower reads its own quarter of the 16x16 sheet, turned half a turn. Bedrock lays a texture onto a horizontal face the other way round from the Java model, and a rotation survives the block being turned to face east or west, which a mirrored UV does not.
          "name": "petals_1",
          "pivot": [0, 0, 0],
          "cubes": [
            {
              "origin": [0, 3, -8],
              "size": [8, 0, 8],
              "uv": {
                "up": { "uv": [0, 0], "uv_size": [8, 8], "uv_rotation": 180 },
                "down": { "uv": [0, 0], "uv_size": [8, 8], "uv_rotation": 180 }
              }
            },
            {
              // The stem sprite is a single pixel column three pixels tall, so a stem is two crossed strips cut out of it. Both sides of each strip are drawn: single-sided culling shows the near one and hides the far one, so the pair never fights over the same pixels.
              "origin": [3.5, 0, -4],
              "size": [1, 3, 0],
              "uv": {
                "north": { "uv": [0, 4], "uv_size": [1, 3], "material_instance": "stem" },
                "south": { "uv": [0, 4], "uv_size": [1, 3], "material_instance": "stem" }
              }
            },
            {
              "origin": [4, 0, -4.5],
              "size": [0, 3, 1],
              "uv": {
                "east": { "uv": [0, 4], "uv_size": [1, 3], "material_instance": "stem" },
                "west": { "uv": [0, 4], "uv_size": [1, 3], "material_instance": "stem" }
              }
            }
          ]
        },
        {
          "name": "petals_2",
          "pivot": [0, 0, 0],
          "cubes": [
            {
              "origin": [0, 1, 0],
              "size": [8, 0, 8],
              "uv": {
                "up": { "uv": [0, 8], "uv_size": [8, 8], "uv_rotation": 180 },
                "down": { "uv": [0, 8], "uv_size": [8, 8], "uv_rotation": 180 }
              }
            },
            {
              "origin": [3.5, 0, 4],
              "size": [1, 1, 0],
              "uv": {
                "north": { "uv": [0, 6], "uv_size": [1, 1], "material_instance": "stem" },
                "south": { "uv": [0, 6], "uv_size": [1, 1], "material_instance": "stem" }
              }
            },
            {
              "origin": [4, 0, 3.5],
              "size": [0, 1, 1],
              "uv": {
                "east": { "uv": [0, 6], "uv_size": [1, 1], "material_instance": "stem" },
                "west": { "uv": [0, 6], "uv_size": [1, 1], "material_instance": "stem" }
              }
            }
          ]
        },
        {
          "name": "petals_3",
          "pivot": [0, 0, 0],
          "cubes": [
            {
              "origin": [-8, 2, 0],
              "size": [8, 0, 8],
              "uv": {
                "up": { "uv": [8, 8], "uv_size": [8, 8], "uv_rotation": 180 },
                "down": { "uv": [8, 8], "uv_size": [8, 8], "uv_rotation": 180 }
              }
            },
            {
              "origin": [-4.5, 0, 4],
              "size": [1, 2, 0],
              "uv": {
                "north": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" },
                "south": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" }
              }
            },
            {
              "origin": [-4, 0, 3.5],
              "size": [0, 2, 1],
              "uv": {
                "east": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" },
                "west": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" }
              }
            }
          ]
        },
        {
          "name": "petals_4",
          "pivot": [0, 0, 0],
          "cubes": [
            {
              "origin": [-8, 2, -8],
              "size": [8, 0, 8],
              "uv": {
                "up": { "uv": [8, 0], "uv_size": [8, 8], "uv_rotation": 180 },
                "down": { "uv": [8, 0], "uv_size": [8, 8], "uv_rotation": 180 }
              }
            },
            {
              "origin": [-4.5, 0, -4],
              "size": [1, 2, 0],
              "uv": {
                "north": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" },
                "south": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" }
              }
            },
            {
              "origin": [-4, 0, -4.5],
              "size": [0, 2, 1],
              "uv": {
                "east": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" },
                "west": { "uv": [0, 5], "uv_size": [1, 2], "material_instance": "stem" }
              }
            }
          ]
        }
      ]
    }
  ]
}
