{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:melon_stem",
      // The stem never shows in the inventory. Its seeds are the item that places it.
      "menu_category": {
        "category": "none"
      },
      // Custom block states. Eight growth stages like vanilla, and which side the fruit grew on. A stem bends towards its fruit and straightens again when the fruit goes.
      "states": {
        "kai_templates:growth": [0, 1, 2, 3, 4, 5, 6, 7],
        "kai_templates:attached": ["none", "north", "south", "east", "west"]
      }
    },
    // Component overrides that apply while their Molang condition is true. Each stage swaps in the sprite coloured for that age, and the bent stem is drawn reaching west; the other three directions turn it.
    "permutations": [
      {
        "condition": "q.block_state('kai_templates:growth') == 1 && q.block_state('kai_templates:attached') == 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 4, 2]
          },
          "minecraft:loot": "loot_tables/blocks/melon_stem_1.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_1",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 2 && q.block_state('kai_templates:attached') == 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 6, 2]
          },
          "minecraft:loot": "loot_tables/blocks/melon_stem_2.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_2",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 3 && q.block_state('kai_templates:attached') == 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 8, 2]
          },
          "minecraft:loot": "loot_tables/blocks/melon_stem_3.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_3",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 4 && q.block_state('kai_templates:attached') == 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 10, 2]
          },
          "minecraft:loot": "loot_tables/blocks/melon_stem_4.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_4",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 5 && q.block_state('kai_templates:attached') == 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 12, 2]
          },
          "minecraft:loot": "loot_tables/blocks/melon_stem_5.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_5",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 6 && q.block_state('kai_templates:attached') == 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 14, 2]
          },
          "minecraft:loot": "loot_tables/blocks/melon_stem_6.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_6",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 7 || q.block_state('kai_templates:attached') != 'none'",
        "components": {
          "minecraft:selection_box": {
            "origin": [-1, 0, -1],
            "size": [2, 16, 2]
          },
          // A ripe stem, bent or straight, gives seeds at the best rate.
          "minecraft:loot": "loot_tables/blocks/melon_stem_7.json",
          "minecraft:material_instances": {
            "*": {
              "texture": "kai_templates_melon_stem_7",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            },
            "arm": {
              "texture": "kai_templates_melon_stem_attached",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:attached') == 'east'",
        "components": {
          // Rotates, scales or offsets the geometry and boxes for this permutation.
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:attached') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:attached') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 270, 0]
          }
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.melon_stem.name",
      // Block tags. Vanilla content and Molang queries can match on them. Vanilla marks its crops with this tag.
      "minecraft:tags": ["minecraft:crop", "kai_templates:melon_stem"],
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:melon_stem_growth": {},
      // The vanilla or custom geometry used by the block. One geometry holds every shape, and each bone shows itself for the states it belongs to.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_melon_stem",
        "bone_visibility": {
          "stage_0": "q.block_state('kai_templates:growth') == 0 && q.block_state('kai_templates:attached') == 'none'",
          "stage_1": "q.block_state('kai_templates:growth') == 1 && q.block_state('kai_templates:attached') == 'none'",
          "stage_2": "q.block_state('kai_templates:growth') == 2 && q.block_state('kai_templates:attached') == 'none'",
          "stage_3": "q.block_state('kai_templates:growth') == 3 && q.block_state('kai_templates:attached') == 'none'",
          "stage_4": "q.block_state('kai_templates:growth') == 4 && q.block_state('kai_templates:attached') == 'none'",
          "stage_5": "q.block_state('kai_templates:growth') == 5 && q.block_state('kai_templates:attached') == 'none'",
          "stage_6": "q.block_state('kai_templates:growth') == 6 && q.block_state('kai_templates:attached') == 'none'",
          "stage_7": "q.block_state('kai_templates:growth') == 7 && q.block_state('kai_templates:attached') == 'none'",
          "attached_stem": "q.block_state('kai_templates:attached') != 'none'"
        }
      },
      // The texture or textures used by the block. The default is the seed stage; the permutations above swap in the sprite for each later stage, because vanilla colours the stem by age in code and a custom block can only change the texture. Each plane carries a front and a back face, so single-sided keeps them from fighting.
      "minecraft:material_instances": {
        "*": {
          "texture": "kai_templates_melon_stem_0",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "alpha_test_single_sided",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0
        },
        "arm": {
          "texture": "kai_templates_melon_stem_attached",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0
        }
      },
      // The block's collision box.
      "minecraft:collision_box": false,
      // The block's selection box. A thin column that grows with the stem, two pixels per stage.
      "minecraft:selection_box": {
        "origin": [-1, 0, -1],
        "size": [2, 2, 2]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off: trampled farmland turns to dirt and the stem drops on the spot.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": ["minecraft:farmland"]
          }
        ]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // Vanilla sound set used for placing, breaking and stepping on the block. blocks.json would override this, so the template does not ship one.
      "minecraft:sound": {
        "sound": "wood"
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#7FB238",
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": false,
            "on_liquid_touches": "popped"
          }
        ]
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // Loot table used when the block is broken. A fresh stem rarely gives a seed back; the permutations above raise the odds with age.
      "minecraft:loot": "loot_tables/blocks/melon_stem_0.json",
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      }
    }
  }
}
