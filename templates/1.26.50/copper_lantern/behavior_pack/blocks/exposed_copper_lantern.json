{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:exposed_copper_lantern",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "items"
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Sets the enabled state from where the player clicked: the face hit, or the top or bottom half.
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:block_face"]
        }
      }
    },
    // Component overrides that apply while their Molang condition is true.
    "permutations": [
      {
        "condition": "q.block_state('minecraft:block_face') == 'down'",
        "components": {
          "minecraft:geometry": "geometry.kai_templates_copper_lantern_hanging",
          "minecraft:collision_box": {
            "origin": [-3, 1, -3],
            "size": [6, 7, 6]
          },
          "minecraft:selection_box": {
            "origin": [-3, 1, -3],
            "size": [6, 7, 6]
          }
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.exposed_copper_lantern.name",
      // Block tags. Vanilla content and Molang queries can match on them.
      "minecraft:tags": ["kai_templates:copper_lantern"],
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": "geometry.kai_templates_copper_lantern",
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "exposed_copper_lantern",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "alpha_test",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0,
          // Whether each face gets the vanilla directional shading.
          "face_dimming": false
        }
      },
      // Light level the block gives off, 0 to 15.
      "minecraft:light_emission": 15,
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // The block's collision box.
      "minecraft:collision_box": {
        "origin": [-3, 0, -3],
        "size": [6, 7, 6]
      },
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [-3, 0, -3],
        "size": [6, 7, 6]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up", "down"],
            "block_filter": [
              {
                "tags": "!q.any_tag('kai_templates:copper_lantern')"
              }
            ]
          }
        ]
      },
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": false,
            "on_liquid_touches": "blocking"
          }
        ]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 15,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:wooden_tier')"
            },
            "destroy_speed": 7.5
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:stone_tier')"
            },
            "destroy_speed": 1.15
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:iron_tier')"
            },
            "destroy_speed": 0.75
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:diamond_tier')"
            },
            "destroy_speed": 0.55
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:netherite_tier')"
            },
            "destroy_speed": 0.5
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:golden_tier')"
            },
            "destroy_speed": 0.4
          }
        ]
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        // 6 x 5
        "explosion_resistance": 30
      },
      // Texture used for the break particles.
      "minecraft:destruction_particles": {
        "texture": "exposed_copper_lantern"
      },
      // Whether the block carries redstone power like a solid block.
      "minecraft:redstone_conductivity": {
        "redstone_conductor": false
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "push_pull"
      },
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      },
      // Loot table used when the block is broken. Without it the block drops itself.
      "minecraft:loot": "loot_tables/blocks/exposed_copper_lantern.json",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:copper_lantern_oxidize": {},
      // Vanilla sound set used for placing, breaking and stepping on the block. blocks.json would override this, so the template does not ship one.
      "minecraft:sound": {
        "sound": "lantern"
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#C15A36"
    }
  }
}
