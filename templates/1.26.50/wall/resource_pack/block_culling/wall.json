        },
        "direction": "down"
      },
      {
        "geometry_part": {
          "bone": "arm_east",
          "cube": 0,
          "face": "down"
        },
        "direction": "down"
      },
      {
        "geometry_part": {
          "bone": "arm_west",
          "cube": 0,
          "face": "down"
        },
        "direction": "down"
      },
      {
        "geometry_part": {
          "bone": "arm_north_tall",
          "cube": 0,
          "face": "north"
        },
        "direction": "north",
