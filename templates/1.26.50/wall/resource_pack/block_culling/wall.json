      },
      {
        "geometry_part": {
          "bone": "arm_east_tall",
          "cube": 0,
          "face": "east"
        },
        "direction": "east",
        "condition": "same_block"
      },
      {
        "geometry_part": {
          "bone": "arm_east_tall",
          "cube": 0,
          "face": "down"
        },
        "direction": "down"
      },
      {
        "geometry_part": {
          "bone": "arm_west_tall",
          "cube": 0,
