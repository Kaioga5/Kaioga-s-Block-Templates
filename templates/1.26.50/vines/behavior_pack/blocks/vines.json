{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:vines",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "nature"
      },
      // Custom block states. The four sides are the walls the vine holds on to; up only draws the leaf under a solid block overhead.
      "states": {
        "kai_templates:north": [
          false,
          true
        ],
        "kai_templates:south": [
          false,
          true
        ],
        "kai_templates:east": [
          false,
          true
        ],
        "kai_templates:west": [
          false,
          true
        ],
        "kai_templates:up": [
          false,
          true
        ]
      }
    },
    // Component overrides that apply while their Molang condition is true.
    // A vine on one wall is selected by a one-pixel sheet against that wall, like vanilla. On two walls or more vanilla selects the whole block, which is the default below.
    "permutations": [
      {
        "condition": "q.block_state('kai_templates:north') && !q.block_state('kai_templates:south') && !q.block_state('kai_templates:east') && !q.block_state('kai_templates:west')",
        "components": {
          // The block's selection box.
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              16,
              1
            ]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:south') && !q.block_state('kai_templates:north') && !q.block_state('kai_templates:east') && !q.block_state('kai_templates:west')",
        "components": {
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              7
            ],
            "size": [
              16,
              16,
              1
            ]
          }
        }
      },
      {
        // Box X runs opposite to world X, so the east sheet sits at the negative end.
        "condition": "q.block_state('kai_templates:east') && !q.block_state('kai_templates:north') && !q.block_state('kai_templates:south') && !q.block_state('kai_templates:west')",
        "components": {
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              1,
              16,
              16
            ]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:west') && !q.block_state('kai_templates:north') && !q.block_state('kai_templates:south') && !q.block_state('kai_templates:east')",
        "components": {
          "minecraft:selection_box": {
            "origin": [
              7,
              0,
              -8
            ],
            "size": [
              1,
              16,
              16
            ]
          }
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.vines.name",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:vines_life": {},
      "kai_templates:vines_place": {},
      // Block tags. Vanilla content and Molang queries can match on them. The vanilla vine carries exactly this one.
      "minecraft:tags": ["minecraft:is_axe_item_destructible"],
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_vines",
        // Controls which bones are visible when the block is rendered.
        "bone_visibility": {
          "north": "q.block_state('kai_templates:north')",
          "south": "q.block_state('kai_templates:south')",
          "east": "q.block_state('kai_templates:east')",
          "west": "q.block_state('kai_templates:west')",
          "up": "q.block_state('kai_templates:up')"
        }
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "vine",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "alpha_test",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0,
          // Whether each face gets the vanilla directional shading.
          "face_dimming": false,
          // Tints the texture with a biome color, like grass or foliage.
          "tint_method": "default_foliage"
        }
      },
      // The block's collision box.
      "minecraft:collision_box": false,
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [
          -8,
          0,
          -8
        ],
        "size": [
          16,
          16,
          16
        ]
      },
      // Break time, with faster speeds for specific tools. The engine scales these the way it scales a vanilla hardness, so each value is the vine's hardness of 0.2 divided by the tool's speed. Axes need no entry: the axe tag above already lets every axe tier mine at its own vanilla speed.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.2,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.any_tag('minecraft:is_shears')"
            },
            "destroy_speed": 0.1
          }
        ]
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        // 0.2 x 5
        "explosion_resistance": 1
      },
      // Loot table used when the block is broken. Without it the block drops itself.
      "minecraft:loot": "loot_tables/blocks/vines.json",
      // How easily fire catches on and destroys the block.
      "minecraft:flammable": {
        "catch_chance_modifier": 15,
        "destroy_chance_modifier": 100
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": true,
            "on_liquid_touches": "no_reaction"
          }
        ]
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // Lets a player place another block into this block's space, like tall grass.
      "minecraft:replaceable": {},
      // Texture used for the break particles.
      "minecraft:destruction_particles": {
        "texture": "vine",
        "tint_method": "default_foliage"
      },
      // Vanilla sound set used for placing, breaking and stepping on the block. blocks.json would override this, so the template does not ship one.
      "minecraft:sound": {
        "sound": "vines"
      },
      // Color the block shows on maps. The vanilla vine uses this grey and lets the foliage tint colour it.
      "minecraft:map_color": {
        "color": "#AAAAAA",
        "tint_method": "default_foliage"
      },
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      }
    }
  }
}
