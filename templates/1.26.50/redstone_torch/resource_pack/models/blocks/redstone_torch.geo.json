{
  "format_version": "1.26.50",
  "minecraft:geometry": [
    {
      "description": {
        "identifier": "geometry.kai_templates_redstone_torch",
        "texture_width": 16,
        "texture_height": 16,
        "visible_bounds_width": 2,
        "visible_bounds_height": 2,
        "visible_bounds_offset": [0, 0.5, 0]
      },
      "bones": [
        // One bone holds the whole torch: the two pixel stick and the four flat planes standing on its sides.
        {
          "name": "torch",
          "pivot": [0, 0, 0],
          "cubes": [
            // The stick, ten pixels tall, listing only its top and bottom caps.
            // Bedrock draws just the faces a cube names, and the planes below stand exactly on the stick's four sides and already carry those pixels.
            // Two surfaces in the same plane flicker as the camera moves, so the sides are left to the planes rather than drawn twice.
            {
              "origin": [-1, 0, -1],
              "size": [2, 10, 2],
              "uv": {
                "up": { "uv": [7, 6], "uv_size": [2, 2] },
                "down": { "uv": [7, 13], "uv_size": [2, 2] }
              }
            },
            // The four planes, one standing on each side of the stick.
            // Each is four pixels wide and reads the whole column the torch is drawn in: the stick strip down the middle two columns, the wide red head one pixel past it on either side at texture rows 6 and 7.
            // Sixteen tall so the column maps at its own scale, v 6 landing on the stick's top at y 10 and v 16 on its foot at y 0. The rest of the column is transparent.
            // No two faces this model lists sit in the same plane, which is what stops the flicker.
            // alpha_test draws both sides of a flat quad, which the head needs: from a corner the two planes behind the stick are seen from the back.
            // Square on, the plane facing the camera reads as a flat four pixel head. Vanilla gets that head from a small hollow box instead, and the planes match how it reads without a second surface on the stick
            { "origin": [-2, 0, -1], "size": [4, 16, 0], "uv": { "north": { "uv": [6, 0], "uv_size": [4, 16] } } },
            { "origin": [-2, 0, 1], "size": [4, 16, 0], "uv": { "south": { "uv": [6, 0], "uv_size": [4, 16] } } },
            // Block geometry mirrors X, so the east side of the stick is at negative X. From a corner these two cross the pair above into the X a vanilla redstone torch shows
            { "origin": [-1, 0, -2], "size": [0, 16, 4], "uv": { "east": { "uv": [6, 0], "uv_size": [4, 16] } } },
            { "origin": [1, 0, -2], "size": [0, 16, 4], "uv": { "west": { "uv": [6, 0], "uv_size": [4, 16] } } }
          ]
        }
      ]
    },
    {
      "description": {
        "identifier": "geometry.kai_templates_redstone_torch_wall",
        "texture_width": 16,
        "texture_height": 16,
        "visible_bounds_width": 2,
        "visible_bounds_height": 2,
        "visible_bounds_offset": [0, 0.5, 0]
      },
      "bones": [
        // The same torch standing against the north wall of the cell and tipped 22.5 degrees away from it about the foot of the stick.
        // The stick and its planes sit in one bone, so the rotation can only move them together.
        {
          "name": "torch",
          "pivot": [0, 3.5, -8],
          "rotation": [-22.5, 0, 0],
          "cubes": [
            // The stick again with caps only, raised to y 3.5 and pushed back against the wall
            {
              "origin": [-1, 3.5, -9],
              "size": [2, 10, 2],
              "uv": {
                "up": { "uv": [7, 6], "uv_size": [2, 2] },
                "down": { "uv": [7, 13], "uv_size": [2, 2] }
              }
            },
            // North plane, at z -9, the side against the wall
            { "origin": [-2, 3.5, -9], "size": [4, 16, 0], "uv": { "north": { "uv": [6, 0], "uv_size": [4, 16] } } },
            // South plane, at z -7, the side facing into the room
            { "origin": [-2, 3.5, -7], "size": [4, 16, 0], "uv": { "south": { "uv": [6, 0], "uv_size": [4, 16] } } },
            // East plane, at x -1
            { "origin": [-1, 3.5, -10], "size": [0, 16, 4], "uv": { "east": { "uv": [6, 0], "uv_size": [4, 16] } } },
            // West plane, at x 1
            { "origin": [1, 3.5, -10], "size": [0, 16, 4], "uv": { "west": { "uv": [6, 0], "uv_size": [4, 16] } } }
          ]
        }
      ]
    }
  ]
}
