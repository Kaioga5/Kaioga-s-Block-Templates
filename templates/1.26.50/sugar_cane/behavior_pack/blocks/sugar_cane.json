{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:sugar_cane",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "nature"
      },
      // Custom block states. The block counts up on random ticks and stacks a new block on itself when the counter runs out.
      "states": {
        "kai_templates:age": {
          "values": {
            "min": 0,
            "max": 15
          }
        }
      }
    },
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.sugar_cane.name",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:cane_growth": {},
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": "minecraft:geometry.cross",
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "reeds",
          // Controls how the block is rendered using vanilla render methods. This is the one block the vanilla docs use to explain alpha_test_single_sided_to_opaque: cut out and back-face culled up close, and swapped for the cheaper opaque pass once it is far enough away to stop mattering.
          "render_method": "alpha_test_single_sided_to_opaque",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0,
          // Whether each face gets the vanilla directional shading.
          "face_dimming": false,
          // Tints the texture with a biome color, like grass or foliage. Sugar cane is grass-tinted even though it is not grass, which is why a stand looks different in a swamp and a desert.
          "tint_method": "grass"
        }
      },
      // The block's collision box.
      "minecraft:collision_box": false,
      // The block's selection box. Vanilla cane outlines the whole block.
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off. Listing the cane itself is what makes the engine cascade a column: pull the bottom one and every block above loses its footing in turn.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": [
              "kai_templates:sugar_cane",
              "minecraft:sand",
              "minecraft:red_sand",
              "minecraft:dirt",
              "minecraft:coarse_dirt",
              "minecraft:dirt_with_roots",
              "minecraft:grass_block",
              "minecraft:podzol",
              "minecraft:mycelium",
              "minecraft:mud",
              "minecraft:moss_block",
              "minecraft:pale_moss_block",
              {
                "tags": "q.any_tag('kai_templates:cane_support')"
              }
            ]
          }
        ]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // How the block behaves when it detects liquids, such as waterlogging or being washed away. Vanilla cane holds water back rather than washing away, which is what lets a stand be planted right in a pond.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": false,
            "on_liquid_touches": "blocking"
          }
        ]
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // Texture used for the break particles.
      "minecraft:destruction_particles": {
        "texture": "reeds",
        "tint_method": "grass"
      },
      // Vanilla sound set used for placing, breaking and stepping on the block. blocks.json would override this, so the template does not ship one.
      "minecraft:sound": {
        "sound": "grass"
      },
      // Color the block shows on maps.
      "minecraft:map_color": {
        "color": "#8FBB5A",
        "tint_method": "grass"
      },
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      }
    }
  }
}
