{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kai_templates:icicle_break",
      // The pieces a segment bursts into when it lands or breaks away. Vanilla's
      // block-break effect cuts small squares out of the block's texture and
      // throws them about; this does the same off the icicle texture, since the
      // engine only plays its own effect for a block broken by a player.
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/blocks/kai_templates_icicle_middle"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      // One burst per segment, about what a full block scatters.
      "minecraft:emitter_rate_instant": {
        "num_particles": 24
      },
      // Spread through the cell the segment filled, measured from its corner, thrown upward and outward.
      "minecraft:emitter_shape_box": {
        "offset": [0.5, 0.5, 0.5],
        "half_dimensions": [0.3, 0.45, 0.3],
        "direction": ["Math.random(-1, 1)", "Math.random(0.3, 1)", "Math.random(-1, 1)"]
      },
      "minecraft:particle_initial_speed": "Math.random(1, 4)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 / (Math.random(0.0, 1.0) * 0.9 + 0.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 * 0.0375 + 0.0375",
          "v.particle_random_1 * 0.0375 + 0.0375"
        ],
        "facing_camera_mode": "lookat_xyz",
        // A random four-pixel square from the middle eight columns, which is
        // where the icicle art is. The outer columns are empty.
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": ["4 + math.floor(v.particle_random_2 * 2) * 4", "math.floor(v.particle_random_3 * 4) * 4"],
          "uv_size": [4, 4]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -9.8, 0],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 5,
        "coefficient_of_restitution": 0.1,
        "collision_radius": 0.1
      }
    }
  }
}
