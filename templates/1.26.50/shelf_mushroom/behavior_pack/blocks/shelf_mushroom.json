{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:shelf_mushroom",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "nature"
      },
      // Custom block states. The permutations below switch components on their values. Vanilla only ever uses growth 0 (small) and 1 (large).
      "states": {
        "kai_templates:growth": [0, 1]
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Sets the enabled state from where the player clicked: the face hit, or the top or bottom half. The mushroom keeps the wall face it was placed on.
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:block_face"]
        }
      }
    },
    // Component overrides that apply while their Molang condition is true. The model is drawn hugging the south edge of the block; block_face north is that pose, the other faces turn it.
    "permutations": [
      {
        "condition": "q.block_state('minecraft:block_face') == 'south'",
        "components": {
          // Rotates, scales or offsets the geometry and boxes for this permutation.
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 270, 0]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:growth') == 1",
        "components": {
          "minecraft:geometry": {
            "identifier": "geometry.kai_templates_shelf_mushroom_large",
            "culling": "kai_templates:shelf_mushroom_culling"
          },
          "minecraft:material_instances": {
            "*": {
              "texture": "shelf_mushroom_large",
              "render_method": "alpha_test_single_sided",
              "ambient_occlusion": 0
            }
          },
          "minecraft:collision_box": {
            "origin": [-7, 4, -2],
            "size": [14, 7, 10]
          },
          "minecraft:selection_box": {
            "origin": [-7, 6, -2],
            "size": [14, 5, 10]
          },
          // A large mushroom drops two.
          "minecraft:loot": "loot_tables/blocks/shelf_mushroom_large.json"
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.shelf_mushroom.name",
      // Block tags. Vanilla content and Molang queries can match on them.
      "minecraft:tags": ["kai_templates:shelf_mushroom"],
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:shelf_mushroom_bounce": {},
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_shelf_mushroom_small",
        // The block culling rule used to hide the faces pressed against the wall.
        "culling": "kai_templates:shelf_mushroom_culling"
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "shelf_mushroom_small",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "alpha_test_single_sided",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0
        }
      },
      // Makes the block draw its own geometry as the inventory icon, using the gui pose in the geometry file.
      "minecraft:item_visual": {
        "geometry": "geometry.kai_templates_shelf_mushroom_small",
        "material_instances": {
          "*": {
            "texture": "shelf_mushroom_small",
            "render_method": "alpha_test_single_sided",
            "ambient_occlusion": 0
          }
        }
      },
      // The block's collision box. The cap is solid enough to stand on, which is what the bounce script relies on.
      "minecraft:collision_box": {
        "origin": [-5, 4, 1],
        "size": [10, 7, 7]
      },
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [-5, 8, 1],
        "size": [10, 3, 7]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off. Only the four side faces are allowed, and never another shelf mushroom, which has no full side to hold on to.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["north", "south", "east", "west"],
            "block_filter": [
              {
                "tags": "!q.any_tag('kai_templates:shelf_mushroom')"
              }
            ]
          }
        ]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // Texture used for the break particles. Vanilla ships a dedicated particle sheet for this block.
      "minecraft:destruction_particles": {
        "texture": "shelf_mushroom_particle",
        "particle_count": 48
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#BA8524",
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": false,
            "on_liquid_touches": "popped"
          }
        ]
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // How rain and snow interact with the block.
      "minecraft:precipitation_interactions": {
        "precipitation_behavior": "none"
      },
      // Loot table used when the block is broken. A small mushroom drops one.
      "minecraft:loot": "loot_tables/blocks/shelf_mushroom_small.json",
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      }
    }
  }
}
