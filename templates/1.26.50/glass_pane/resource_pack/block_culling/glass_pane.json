{
  "format_version": "1.21.80",
  "minecraft:block_culling_rules": {
    "description": {
      "identifier": "kai_templates:glass_pane_culling"
    },
    // Each rule hides one face of one cube while a neighbour covers that direction.
    "rules": [
      {
        "geometry_part": { "bone": "arm_north", "cube": 0, "face": "north" },
        "direction": "north",
        "condition": "same_block"
      },
      {
        "geometry_part": { "bone": "arm_south", "cube": 0, "face": "south" },
        "direction": "south",
        "condition": "same_block"
      },
      {
        "geometry_part": { "bone": "arm_east", "cube": 0, "face": "east" },
        "direction": "east",
        "condition": "same_block"
      },
      {
        "geometry_part": { "bone": "arm_west", "cube": 0, "face": "west" },
        "direction": "west",
        "condition": "same_block"
      },
      {
        "geometry_part": { "bone": "post_core", "cube": 0, "face": "up" },
        "direction": "up",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "post_core", "cube": 0, "face": "down" },
        "direction": "down",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_north", "cube": 0, "face": "up" },
        "direction": "up",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_north", "cube": 0, "face": "down" },
        "direction": "down",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_south", "cube": 0, "face": "up" },
        "direction": "up",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_south", "cube": 0, "face": "down" },
        "direction": "down",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_east", "cube": 0, "face": "up" },
        "direction": "up",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_east", "cube": 0, "face": "down" },
        "direction": "down",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_west", "cube": 0, "face": "up" },
        "direction": "up",
        "condition": "same_block_permutation"
      },
      {
        "geometry_part": { "bone": "arm_west", "cube": 0, "face": "down" },
        "direction": "down",
        "condition": "same_block_permutation"
      }
    ]
  }
}
