{
  "format_version": "1.21.80",
  "minecraft:block_culling_rules": {
    "description": {
      "identifier": "kai_templates:brittle_ice_culling"
    },
    // Each rule hides one face of one cube while a neighbour in the same culling
    // layer covers that direction. Java hides the faces between ice, frosted ice
    // and brittle ice; give another custom ice block the culling layer named in
    // the block file and the two will hide their shared faces the same way.
    "rules": [
      {
        "geometry_part": {
          "bone": "brittle_ice_cube",
          "cube": 0,
          "face": "north"
        },
        "direction": "north",
        "condition": "same_culling_layer"
      },
      {
        "geometry_part": {
          "bone": "brittle_ice_cube",
          "cube": 0,
          "face": "south"
        },
        "direction": "south",
        "condition": "same_culling_layer"
      },
      {
        "geometry_part": {
          "bone": "brittle_ice_cube",
          "cube": 0,
          "face": "east"
        },
        "direction": "east",
        "condition": "same_culling_layer"
      },
      {
        "geometry_part": {
          "bone": "brittle_ice_cube",
          "cube": 0,
          "face": "west"
        },
        "direction": "west",
        "condition": "same_culling_layer"
      },
      {
        "geometry_part": {
          "bone": "brittle_ice_cube",
          "cube": 0,
          "face": "up"
        },
        "direction": "up",
        "condition": "same_culling_layer"
      },
      {
        "geometry_part": {
          "bone": "brittle_ice_cube",
          "cube": 0,
          "face": "down"
        },
        "direction": "down",
        "condition": "same_culling_layer"
      }
    ]
  }
}
