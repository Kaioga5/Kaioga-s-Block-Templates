{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kai_templates:brittle_ice_crack",
      // The burst of ice chips the block throws off when it first cracks.
      // Vanilla plays its block-break effect here without the break sound;
      // the engine only plays that effect for a block that really breaks,
      // so this copies it with small squares cut from the whole-ice texture.
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/blocks/kai_templates_brittle_ice_0"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      // Vanilla's effect is a 4 x 4 x 4 grid of pieces through the whole block.
      "minecraft:emitter_rate_instant": {
        "num_particles": 64
      },
      // Spread through the cell, measured from its corner, thrown outward from the middle.
      "minecraft:emitter_shape_box": {
        "offset": [0.5, 0.5, 0.5],
        "half_dimensions": [0.5, 0.5, 0.5],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "Math.random(0.5, 2.5)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 / (Math.random(0.0, 1.0) * 0.9 + 0.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 * 0.0375 + 0.0375",
          "v.particle_random_1 * 0.0375 + 0.0375"
        ],
        "facing_camera_mode": "lookat_xyz",
        // A random four-pixel square from anywhere on the texture.
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": ["math.floor(v.particle_random_2 * 4) * 4", "math.floor(v.particle_random_3 * 4) * 4"],
          "uv_size": [4, 4]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -9.8, 0],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 5,
        "coefficient_of_restitution": 0.1,
        "collision_radius": 0.1
      }
    }
  }
}
