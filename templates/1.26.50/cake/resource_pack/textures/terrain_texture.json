{
  "resource_pack_name": "kai_templates_cake",
  "texture_name": "atlas.terrain",
  // Texture aliases. Block and item files refer to these names, not to file paths.
  "texture_data": {
    "kai_templates_cake_top": {
      "textures": "textures/blocks/cake_top"
    },
    "kai_templates_cake_bottom": {
      "textures": "textures/blocks/cake_bottom"
    },
    "kai_templates_cake_side": {
      "textures": "textures/blocks/cake_side"
    },
    "kai_templates_cake_inner": {
      // The sponge shown on the cut face of a bitten cake. Vanilla reaches it through a two-entry cake_west alias that the engine indexes by bite counter; a custom block picks the texture per permutation instead, so the inner face needs an alias of its own.
      "textures": "textures/blocks/cake_inner"
    }
  }
}
