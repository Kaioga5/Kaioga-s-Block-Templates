{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "kai_templates:falling_snow",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      // How deep the drift this entity carries is, the same 0 to 7 the block's height state uses. The script writes it when the drift comes loose, and client_sync is what lets the render controller read it back and draw that depth.
      "properties": {
        "kai_templates:height": {
          "type": "int",
          "range": [0, 7],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["kai_templates_falling_block", "inanimate"]
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true,
        "push_towards_closest_space": false
      },
      // A small box at the bottom of the drift, the same way vanilla's falling blocks keep a small box whatever they are carrying.
      "minecraft:collision_box": {
        "width": 0.05,
        "height": 0.05
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "event": "kai_templates:on_landed",
            "target": "self",
            "filters": {
              "test": "on_ground",
              "value": true
            }
          }
        ]
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 100.0,
          "max_dropped_ticks": 7,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:persistent": {},
      "minecraft:fire_immune": {}
    },
    "events": {
      "kai_templates:on_landed": {
        "queue_command": {
          "command": ["scriptevent kai_templates:snow_fall landed"]
        }
      }
    }
  }
}
