      "minecraft:material_instances": {
        "*": {
          "texture": "kai_templates_candle",
          "render_method": "alpha_test"
        },
        // The flame quads. Drawn flat and unshaded like a particle; the bone is hidden while unlit, but every state has to declare the instance the geometry names.
