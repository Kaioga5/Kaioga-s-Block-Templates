{
  "format_version": "1.21.80",
  "minecraft:block_culling_rules": {
    "description": {
      "identifier": "kai_templates:iron_bars_culling"
    },
    // Each rule hides one face of one cube while a neighbour covers that direction. Only one rule per face is allowed, so the arm ends cull against other iron bars (vanilla draws no face where two bars join); against a solid block they are hidden inside it anyway.
    "rules": [
      {
        "geometry_part": {
          "bone": "arm_north",
          "cube": 1,
          "face": "north"
        },
        "direction": "north",
        "condition": "same_block"
      },
      {
        "geometry_part": {
          "bone": "arm_south",
          "cube": 1,
          "face": "south"
        },
        "direction": "south",
        "condition": "same_block"
      },
      {
        "geometry_part": {
          "bone": "arm_east",
          "cube": 1,
          "face": "east"
        },
        "direction": "east",
        "condition": "same_block"
      },
      {
        "geometry_part": {
          "bone": "arm_west",
          "cube": 1,
          "face": "west"
        },
        "direction": "west",
        "condition": "same_block"
      }
    ]
  }
}
