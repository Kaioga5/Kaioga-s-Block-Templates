{
  "format_version": "1.26.60",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:iron_bars",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "construction"
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Lets the engine track which neighbours this block connects to.
        "minecraft:connection": {
          "enabled_states": ["minecraft:cardinal_connections"]
        }
      }
    },
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.iron_bars.name",
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_iron_bars",
        // The block culling rule used to hide faces against neighbours.
        "culling": "kai_templates:iron_bars_culling",
        // Controls which bones are visible when the block is rendered. Like vanilla, each bar plane always spans the two centre texels; vanilla swaps those two texels on the north-south plane when east is connected and west is not, and on the east-west plane when north is connected and south is not. The two-pixel end face that closes a plane past the centre shows only on a bar with a single connection.
        "bone_visibility": {
          "post": "!q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_south') && !q.block_state('minecraft:connection_east') && !q.block_state('minecraft:connection_west')",
          "post_caps": true,
          "arm_north": "q.block_state('minecraft:connection_north')",
          "arm_south": "q.block_state('minecraft:connection_south')",
          "arm_east": "q.block_state('minecraft:connection_east')",
          "arm_west": "q.block_state('minecraft:connection_west')",
          "end_north": "q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_south') && !q.block_state('minecraft:connection_east') && !q.block_state('minecraft:connection_west')",
          "end_south": "q.block_state('minecraft:connection_south') && !q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_east') && !q.block_state('minecraft:connection_west')",
          "end_east": "q.block_state('minecraft:connection_east') && !q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_south') && !q.block_state('minecraft:connection_west')",
          "end_west": "q.block_state('minecraft:connection_west') && !q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_south') && !q.block_state('minecraft:connection_east')",
          "centre_ns": "(q.block_state('minecraft:connection_north') || q.block_state('minecraft:connection_south')) && !(q.block_state('minecraft:connection_east') && !q.block_state('minecraft:connection_west'))",
          "centre_ns_swapped": "(q.block_state('minecraft:connection_north') || q.block_state('minecraft:connection_south')) && q.block_state('minecraft:connection_east') && !q.block_state('minecraft:connection_west')",
          "centre_ew": "(q.block_state('minecraft:connection_east') || q.block_state('minecraft:connection_west')) && !(q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_south'))",
          "centre_ew_swapped": "(q.block_state('minecraft:connection_east') || q.block_state('minecraft:connection_west')) && q.block_state('minecraft:connection_north') && !q.block_state('minecraft:connection_south')"
        }
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "iron_bars",
          // Controls how the block is rendered using vanilla render methods. alpha_test draws faces from both sides: like vanilla, every bar plane and edge is a single quad seen from either side.
          "render_method": "alpha_test",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0
        }
      },
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "all"
      },
      // The block's collision box.
      "minecraft:collision_box": [
        {
          "origin": [-1, 0, -1],
          "size": [2, 16, 2]
        }
      ],
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [-1, 0, -1],
        "size": [2, 16, 2]
      },
      // The block's support shape. Only vanilla shapes are supported.
      "minecraft:support": {
        "shape": "fence"
      },
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true
          }
        ]
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // Break time. The engine takes 1.5 times seconds_to_destroy, so 16.6667 gives vanilla's 25 s by hand or with any tool that is not a pickaxe. A pickaxe divides destroy_speed by its own mining speed (Efficiency and Haste included) because the block carries the minecraft:is_pickaxe_item_destructible tag, so 5, iron bars' hardness, reproduces vanilla's time for every tier. Measured against vanilla tick for tick.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 16.6667,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.any_tag('minecraft:is_pickaxe')"
            },
            "destroy_speed": 5
          }
        ]
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        // 6 x 5
        "explosion_resistance": 30
      },
      // Vanilla sound set used for placing, breaking and stepping on the block. blocks.json would override this, so the template does not ship one.
      "minecraft:sound": {
        "sound": "iron"
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#979797",
      // Loot table used when the block is broken. Without it the block drops itself.
      "minecraft:loot": "loot_tables/blocks/iron_bars.json",
      // Block tags. Vanilla content and Molang queries can match on them. has_fence_connections lets the connection trait join this block to itself and lets vanilla bars, panes and walls connect to it. metal and minecraft:is_pickaxe_item_destructible are the vanilla iron bars' own tags; the second one also makes pickaxes apply their mining speed (see destructible_by_mining).
      "minecraft:tags": ["minecraft:has_fence_connections", "metal", "minecraft:is_pickaxe_item_destructible"]
    },
