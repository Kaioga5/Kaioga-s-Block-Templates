{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kai_templates:falling_leaf",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/biome_tinted_leaves_atlas"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.5
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0.5,
          -0.075,
          0.5
        ],
        "half_dimensions": [
          0.5,
          0,
          0.5
        ],
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 6
      },
      "minecraft:particle_initial_speed": [
        0,
        -0.02,
        0
      ],
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 > 0.5 ? 0.1 : 0.15",
          "v.particle_random_1 > 0.5 ? 0.1 : 0.15"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 28,
          "texture_height": 21,
          "uv": [
            "math.floor(v.particle_random_1 * 4) * 7",
            "math.floor(v.particle_random_2 * 3) * 7"
          ],
          "uv_size": [
            7,
            7
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.leaf_color.r",
          "v.leaf_color.g",
          "v.leaf_color.b",
          1
        ]
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.cos(v.particle_age * 200 + v.particle_random_3 * 360) * 0.8",
          -0.3,
          "math.sin(v.particle_age * 200 + v.particle_random_3 * 360) * 0.8"
        ],
        "rotation_acceleration": "v.particle_random_4 > 0.5 ? -5 : 5"
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 10,
        "collision_radius": 0.075,
        "expire_on_contact": true
      }
    }
  }
}
