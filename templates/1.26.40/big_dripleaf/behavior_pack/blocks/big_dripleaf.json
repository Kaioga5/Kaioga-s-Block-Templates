{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:big_dripleaf",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "nature"
      },
      // Custom block states. The permutations below switch components on their values.
      "states": {
        "kai_templates:head": [
          true,
          false
        ],
        "kai_templates:tilt": [
          "none",
          "unstable",
          "partial",
          "full"
        ]
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Sets the enabled state from the direction the player faces when placing.
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          // The trait records the way the player looks. A vanilla dripleaf is placed with its blade toward the player and its stem on the far side, the opposite of that, so the recorded direction is turned half a turn. Without this every facing comes out backwards.
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.big_dripleaf.name",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:dripleaf_tilt": {},
      "kai_templates:dripleaf_growth": {},
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_big_dripleaf",
        // Controls which bones are visible when the block is rendered.
        "bone_visibility": {
          "stem": "q.block_state('kai_templates:head') == false",
          "stem_head": "q.block_state('kai_templates:head')",
          "leaf_flat": "q.block_state('kai_templates:head') && (q.block_state('kai_templates:tilt') == 'none' || q.block_state('kai_templates:tilt') == 'unstable')",
          "leaf_partial": "q.block_state('kai_templates:head') && q.block_state('kai_templates:tilt') == 'partial'",
          "leaf_full": "q.block_state('kai_templates:head') && q.block_state('kai_templates:tilt') == 'full'"
        }
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "big_dripleaf_stem",
          // Controls how the block is rendered using vanilla render methods. Single-sided keeps backface culling on; every quad in the model declares both of its faces, so the leaf is still visible from underneath.
          "render_method": "alpha_test_single_sided",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0,
          // Whether each face gets the vanilla directional shading.
          "face_dimming": false
        },
        "stem": {
          "texture": "big_dripleaf_stem",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0,
          "face_dimming": false
        },
        "top": {
          "texture": "big_dripleaf_top",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0,
          "face_dimming": false
        },
        "side": {
          "texture": "big_dripleaf_side1",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0,
          "face_dimming": false
        },
        "tip": {
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0,
          "texture": "big_dripleaf_side2",
          "face_dimming": false
        }
      },
      // The block's collision box. A stem has none in vanilla: you walk straight through the stalk and only the leaf holds weight.
      "minecraft:collision_box": false,
      // The block's selection box. The stem stands in the block's south quarter, six pixels wide, so that is what the cursor picks up.
      "minecraft:selection_box": {
        "origin": [
          -3,
          0,
          1
        ],
        "size": [
          6,
          16,
          6
        ]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": [
              "up"
            ],
            "block_filter": [
              "minecraft:clay",
              "minecraft:moss_block",
              "minecraft:pale_moss_block",
              "minecraft:dirt",
              "minecraft:coarse_dirt",
              "minecraft:grass_block",
              "minecraft:mud",
              "minecraft:muddy_mangrove_roots",
              "minecraft:farmland",
              "kai_templates:big_dripleaf",
              {
                "tags": "q.any_tag('kai_templates:flower_support')"
              }
            ]
          }
        ]
      },
      // Makes the block receive redstone power and get onRedstoneUpdate events.
      "minecraft:redstone_consumer": {
        "min_power": 1,
        "propagates_power": false
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.15
      },
      // Resistance to explosions. Bedrock stores five times the blast resistance the wiki lists for a block, so the listed number goes in multiplied by five.
      "minecraft:destructible_by_explosion": {
        // 0.1 x 5
        "explosion_resistance": 0.5
      },
      // How easily fire catches on and destroys the block.
      "minecraft:flammable": {
        "catch_chance_modifier": 15,
        "destroy_chance_modifier": 100
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": true,
            "on_liquid_touches": "no_reaction"
          }
        ]
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#6F8D33",
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      }
    },
    // Component overrides that apply while their Molang condition is true.
    "permutations": [
      {
        "condition": "q.block_state('kai_templates:head') == false",
        "components": {
          "minecraft:collision_box": false,
          "minecraft:selection_box": {
            "origin": [
              -3,
              0,
              1
            ],
            "size": [
              6,
              16,
              6
            ]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:head') && (q.block_state('kai_templates:tilt') == 'none' || q.block_state('kai_templates:tilt') == 'unstable')",
        "components": {
          // The leaf holds weight while it is level or only wobbling: vanilla's pad runs from pixel 11 to 15.
          "minecraft:collision_box": {
            "origin": [
              -8,
              11,
              -8
            ],
            "size": [
              16,
              4,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              11,
              -8
            ],
            "size": [
              16,
              4,
              16
            ]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:head') && q.block_state('kai_templates:tilt') == 'partial'",
        "components": {
          // Half way down the pad is two pixels tall, so whatever stands on it sinks with the leaf.
          "minecraft:collision_box": {
            "origin": [
              -8,
              11,
              -8
            ],
            "size": [
              16,
              2,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              11,
              -8
            ],
            "size": [
              16,
              2,
              16
            ]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:head') && q.block_state('kai_templates:tilt') == 'full'",
        "components": {
          // Fully tilted, the leaf holds nothing: this is the moment a player falls through.
          "minecraft:collision_box": false,
          // With the pad out of the way only the stem stub under it can be picked up, which is what vanilla selects too.
          "minecraft:selection_box": {
            "origin": [
              -3,
              0,
              1
            ],
            "size": [
              6,
              13,
              6
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          // Rotates, scales or offsets the geometry and boxes for this permutation.
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      }
    ]
  }
}
