{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:redstone_torch",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "items"
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Sets the enabled state from where the player clicked: the face hit, or the top or bottom half.
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:block_face"]
        }
      },
      // Custom block states. The permutations below switch components on their values.
      "states": {
        "kai_templates:lit": [true, false]
      }
    },
    // Component overrides that apply while their Molang condition is true.
    "permutations": [
      {
        "condition": "q.block_state('minecraft:block_face') == 'up' && q.block_state('kai_templates:lit')",
        "components": {
          // Light level the block gives off, 0 to 15.
          "minecraft:light_emission": 7,
          "minecraft:redstone_producer": {
            "power": 15,
            "connected_faces": ["up", "north", "south", "west", "east"],
            "strongly_powered_face": "up"
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'south'",
        "components": {
          "minecraft:geometry": "geometry.kai_templates_redstone_torch_wall",
          "minecraft:selection_box": {
            "origin": [-2, 3, -8],
            "size": [4, 11, 7]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'north'",
        "components": {
          "minecraft:geometry": "geometry.kai_templates_redstone_torch_wall",
          "minecraft:selection_box": {
            "origin": [-2, 3, -8],
            "size": [4, 11, 7]
          },
          // Rotates, scales or offsets the geometry and boxes for this permutation.
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'east'",
        "components": {
          "minecraft:geometry": "geometry.kai_templates_redstone_torch_wall",
          "minecraft:selection_box": {
            "origin": [-2, 3, -8],
            "size": [4, 11, 7]
          },
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:geometry": "geometry.kai_templates_redstone_torch_wall",
          "minecraft:selection_box": {
            "origin": [-2, 3, -8],
            "size": [4, 11, 7]
          },
          "minecraft:transformation": {
            "rotation": [0, 270, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:block_face') != 'up' && q.block_state('kai_templates:lit')",
        "components": {
          "minecraft:light_emission": 7,
          "minecraft:redstone_producer": {
            "power": 15,
            "connected_faces": ["down", "up", "south", "west", "east"],
            "strongly_powered_face": "up",
            "transform_relative": true
          }
        }
      },
      {
        "condition": "!q.block_state('kai_templates:lit')",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "redstone_torch_off",
              // Controls how the block is rendered using vanilla render methods.
              "render_method": "alpha_test",
              // Whether neighbouring blocks darken this block's corners.
              "ambient_occlusion": 0,
              // Whether each face gets the vanilla directional shading.
              "face_dimming": false
            }
          }
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.redstone_torch.name",
      // Block tags. Vanilla content and Molang queries can match on them.
      "minecraft:tags": ["kai_templates:redstone_torch"],
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": "geometry.kai_templates_redstone_torch",
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "redstone_torch_on",
          "render_method": "alpha_test",
          "ambient_occlusion": 0,
          "face_dimming": false
        }
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // The block's collision box.
      "minecraft:collision_box": false,
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [-2, 0, -2],
        "size": [4, 10, 4]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up", "north", "south", "east", "west"],
            "block_filter": [
              {
                "tags": "!q.any_tag('kai_templates:redstone_torch')"
              }
            ]
          }
        ]
      },
      // Makes the block output a redstone signal.
      "minecraft:redstone_producer": {
        "power": 0
      },
      // Whether the block carries redstone power like a solid block.
      "minecraft:redstone_conductivity": {
        "redstone_conductor": false,
        "allows_wire_to_step_down": false
      },
      // Sends onTick events to the scripts on this interval.
      "minecraft:tick": {
        "interval_range": [2, 2],
        "looping": true
      },
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": false,
            "on_liquid_touches": "popped"
          }
        ]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      // Resistance to explosions.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0
      },
      // Texture used for the break particles.
      "minecraft:destruction_particles": {
        "texture": "redstone_torch_on"
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      },
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:redstone_torch_invert": {}
    }
  }
}
