{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:oxidized_copper_stairs",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "construction"
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Sets the enabled state from the direction the player faces when placing.
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:corner_and_cardinal_direction"
          ],
          // Which blocks this stair turns a corner against. Left out, the engine only corners a stair with its own id. The tag query matches vanilla stairs and every other stair that carries the same tag, and the tag on this block is what lets those stairs corner back.
          "blocks_to_corner_with": [
            {
              "tags": "q.any_tag('minecraft:cornerable_stairs')"
            }
          ]
        },
        // Sets the enabled state from where the player clicked: the face hit, or the top or bottom half.
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:vertical_half"
          ]
        }
      }
    },
    // Component overrides that apply while their Molang condition is true.
    "permutations": [
      {
        "condition": "q.block_state('minecraft:corner') == 'none' && q.block_state('minecraft:vertical_half') == 'bottom'",
