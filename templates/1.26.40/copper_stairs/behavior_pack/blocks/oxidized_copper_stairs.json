          // Rotates, scales or offsets the geometry and boxes for this permutation.
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.oxidized_copper_stairs.name",
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_copper_stairs",
          // Keeps the texture facing the same way in every rotation, the way vanilla stairs draw their grain. Without it the transformation below turns the texture with the block.
        "uv_lock": true,
        // Which of the eight quarter bones are drawn. One geometry covers all ten shapes: the four quarters of the solid half are always on, and the quarters of the other half follow minecraft:corner. The names describe the quarter while the stair faces north, which is how the geometry is authored, before the facing permutations turn it.
        "bone_visibility": {
          // Right way up these four are the solid lower slab, so they are always on. Upside down they are the step that hangs below, so the corner state picks them.
          "north_east_bottom": "q.block_state('minecraft:vertical_half') == 'bottom' || q.block_state('minecraft:corner') != 'outer_left'",
          "north_west_bottom": "q.block_state('minecraft:vertical_half') == 'bottom' || q.block_state('minecraft:corner') != 'outer_right'",
          "south_east_bottom": "q.block_state('minecraft:vertical_half') == 'bottom' || q.block_state('minecraft:corner') == 'inner_right'",
          "south_west_bottom": "q.block_state('minecraft:vertical_half') == 'bottom' || q.block_state('minecraft:corner') == 'inner_left'",
          // The four top quarters, the other way round: upside down they are the solid slab, right way up they are the step.
          "north_east_top": "q.block_state('minecraft:vertical_half') == 'top' || q.block_state('minecraft:corner') != 'outer_left'",
          "north_west_top": "q.block_state('minecraft:vertical_half') == 'top' || q.block_state('minecraft:corner') != 'outer_right'",
          "south_east_top": "q.block_state('minecraft:vertical_half') == 'top' || q.block_state('minecraft:corner') == 'inner_right'",
          "south_west_top": "q.block_state('minecraft:vertical_half') == 'top' || q.block_state('minecraft:corner') == 'inner_left'"
        }
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "oxidized_cut_copper",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "opaque"
        }
      },
      // Geometry and textures the item form shows in the inventory and in hand. A geometry's item_display_transforms only reach the icon through item_visual, so the block names its own geometry again here.
      "minecraft:item_visual": {
        "geometry": {
          "identifier": "geometry.kai_templates_copper_stairs",
          "uv_lock": true,
          // An item has no block states, so the Molang above cannot choose a shape for the icon. These constants pick a plain straight stair out of the same bones: the whole bottom slab plus the east half of the top, the half the vanilla stair model raises. The geometry's gui pose turns the icon a quarter turn from the usual block angle, so that half lands at the back left of the slot where the vanilla icon has it.
          // The values are Molang strings, not JSON booleans. The engine types every bone_visibility entry as an expression or a number and rejects true/false here, which drops the whole block from the registry.
          "bone_visibility": {
            "north_east_bottom": "true",
            "north_west_bottom": "true",
            "south_east_bottom": "true",
            "south_west_bottom": "true",
            "north_east_top": "true",
            "north_west_top": "false",
            "south_east_top": "true",
            "south_west_top": "false"
          }
        },
        "material_instances": {
          "*": {
            "texture": "oxidized_cut_copper",
            "render_method": "opaque"
          }
        }
      },
      // Block tags. Vanilla content and Molang queries can match on them. Vanilla stairs corner against blocks carrying this one, which is the other direction of the corner the trait above asks for.
      "minecraft:tags": [
        "minecraft:cornerable_stairs"
      ],
      // The block's support shape. Only vanilla shapes are supported.
      "minecraft:support": {
        "shape": "stair"
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#C15A36",
      // Whether the block carries redstone power like a solid block.
      "minecraft:redstone_conductivity": {
        "redstone_conductor": false
      },
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": true,
            "on_liquid_touches": "no_reaction"
          }
        ]
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 3,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:wooden_tier')"
            },
            "destroy_speed": 1.15
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:stone_tier')"
            },
            "destroy_speed": 0.6
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:iron_tier')"
            },
            "destroy_speed": 0.4
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:diamond_tier')"
            },
            "destroy_speed": 0.3
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:netherite_tier')"
            },
            "destroy_speed": 0.25
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:golden_tier')"
            },
            "destroy_speed": 0.2
          }
        ]
      },
      // Resistance to explosions.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6
      },
      // The instrument a note block plays when it sits on this block.
      "minecraft:instrument_sound": {
        "up": "note.trumpet_oxidized"
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "push_pull"
      },
      // Loot table used when the block is broken. Without it the block drops itself.
      "minecraft:loot": "loot_tables/blocks/oxidized_copper_stairs.json",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:copper_stairs_oxidize": {}
    }
