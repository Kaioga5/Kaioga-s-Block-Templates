{
  "format_version": "1.21.80",
  "minecraft:block_culling_rules": {
    "description": {
      "identifier": "kai_templates:culling.fence"
    },
    // Each rule hides one face of one cube while a neighbour covers that direction.
    "rules": [
      {
        "geometry_part": { "bone": "arm_north", "cube": 0, "face": "north" },
        "direction": "north"
      },
      {
        "geometry_part": { "bone": "arm_north", "cube": 1, "face": "north" },
        "direction": "north"
      },
      {
        "geometry_part": { "bone": "arm_south", "cube": 0, "face": "south" },
        "direction": "south"
      },
      {
        "geometry_part": { "bone": "arm_south", "cube": 1, "face": "south" },
        "direction": "south"
      },
      {
        "geometry_part": { "bone": "arm_east", "cube": 0, "face": "east" },
        "direction": "east"
      },
      {
        "geometry_part": { "bone": "arm_east", "cube": 1, "face": "east" },
        "direction": "east"
      },
      {
        "geometry_part": { "bone": "arm_west", "cube": 0, "face": "west" },
        "direction": "west"
      },
      {
        "geometry_part": { "bone": "arm_west", "cube": 1, "face": "west" },
        "direction": "west"
      },
      {
        "geometry_part": { "bone": "post", "cube": 0, "face": "up" },
        "direction": "up"
      },
      {
        "geometry_part": { "bone": "post", "cube": 0, "face": "down" },
        "direction": "down"
      }
    ]
  }
}
