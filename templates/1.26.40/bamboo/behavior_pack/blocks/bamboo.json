{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:bamboo",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "nature"
      },
      // Custom block states. The permutations below switch components on their values.
      "states": {
        "kai_templates:thick": [
          false,
          true
        ],
        "kai_templates:leaves": [
          "none",
          "small",
          "large"
        ],
        "kai_templates:mature": [
          false,
          true
        ],
        // True for the shoot a planted stalk starts from. Vanilla keeps the shoot as a separate block; here it is the same block wearing the shoot look.
        // The first value of a state is its default, so true comes first: a freshly placed bamboo is the shoot on its first frame, and the script only rewrites it when it lands on bamboo.
        "kai_templates:shoot": [
          true,
          false
        ]
      }
    },
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.bamboo.name",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:bamboo_growth": {},
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_bamboo",
        // Controls which bones are visible when the block is rendered.
        "bone_visibility": {
          "shoot": "q.block_state('kai_templates:shoot')",
          "stem_thin": "!q.block_state('kai_templates:shoot') && q.block_state('kai_templates:thick') == false",
          "stem_thick": "!q.block_state('kai_templates:shoot') && q.block_state('kai_templates:thick')",
          "leaves_small": "!q.block_state('kai_templates:shoot') && q.block_state('kai_templates:leaves') == 'small'",
          "leaves_large": "!q.block_state('kai_templates:shoot') && q.block_state('kai_templates:leaves') == 'large'"
        }
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "bamboo_stem",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "alpha_test_single_sided",
          // Whether neighbouring blocks darken this block's corners. Vanilla draws the stalk evenly lit; with this on, the foot of the stalk goes dark against the ground.
          "ambient_occlusion": 0
        },
        "stem": {
          "texture": "bamboo_stem",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0
        },
        "leaf_small": {
          "texture": "bamboo_small_leaf",
          "render_method": "alpha_test_single_sided",
          // The leaves keep the vanilla directional shading (face_dimming stays on). Without it they render brighter than the vanilla plant next to them.
          "ambient_occlusion": 0
        },
        "leaf_large": {
          "texture": "bamboo_leaf",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0
        },
        "shoot": {
          "texture": "bamboo_sapling",
          "render_method": "alpha_test_single_sided",
          "ambient_occlusion": 0,
          // Whether each face gets the vanilla directional shading. The shoot is a plant cross, drawn flat like vanilla's.
          "face_dimming": false
        }
      },
      // The block's collision box: the thick stem. The thin stem and the shoot override it below.
      "minecraft:collision_box": {
        "origin": [
          -1.5,
          0,
          -1.5
        ],
        "size": [
          3,
          16,
          3
        ]
      },
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [
          -1.5,
          0,
          -1.5
        ],
        "size": [
          3,
          16,
          3
        ]
      },
      // Faces and blocks the block may be placed against. When the rule stops holding, the block pops off. This list is the only place that decides what bamboo may be planted on; the scripts do not check soil.
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": [
              "up"
            ],
            "block_filter": [
              "minecraft:grass_block",
              "minecraft:dirt",
              "minecraft:coarse_dirt",
              "minecraft:dirt_with_roots",
              "minecraft:podzol",
              "minecraft:mycelium",
              "minecraft:sand",
              "minecraft:red_sand",
              "minecraft:gravel",
              "minecraft:moss_block",
              "minecraft:mud",
              {
                "tags": "q.any_tag('kai_templates:flower_support')"
              },
              "kai_templates:bamboo"
            ]
          }
        ]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.any_tag('minecraft:is_sword')"
            },
            "destroy_speed": 0.05
          },
          {
            "item": {
              "tags": "q.any_tag('minecraft:is_axe')"
            },
            "destroy_speed": 0.75
          }
        ]
      },
      // Resistance to explosions.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1
      },
      // Loot table used when the block is broken. Without it the block drops itself.
      "minecraft:loot": "loot_tables/blocks/bamboo.json",
      // How easily fire catches on and destroys the block.
      "minecraft:flammable": {
        "catch_chance_modifier": 15,
        "destroy_chance_modifier": 60
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 0,
      // Random per-position offset of the model, like vanilla flowers.
      "minecraft:random_offset": {
        "x": {
          "range": {
            "min": -2,
            "max": 2
          },
          "steps": 0
        },
        "z": {
          "range": {
            "min": -2,
            "max": 2
          },
          "steps": 0
        }
      },
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": false,
            "on_liquid_touches": "popped"
          }
        ]
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "popped"
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#5D9013",
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      }
    },
    // Component overrides that apply while their Molang condition is true.
    "permutations": [
      {
        // The thin stem is two pixels wide, so its boxes shrink with it.
        "condition": "!q.block_state('kai_templates:shoot') && !q.block_state('kai_templates:thick')",
        "components": {
          "minecraft:collision_box": {
            "origin": [
              -1,
              0,
              -1
            ],
            "size": [
              2,
              16,
              2
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -1,
              0,
              -1
            ],
            "size": [
              2,
              16,
              2
            ]
          }
        }
      },
      {
        // The shoot is a plant: nothing to bump into, and a wider, shorter outline to pick it up with.
        "condition": "q.block_state('kai_templates:shoot')",
        "components": {
          "minecraft:collision_box": false,
          "minecraft:selection_box": {
            "origin": [
              -4,
              0,
              -4
            ],
            "size": [
              8,
              12,
              8
            ]
          }
        }
      }
    ]
  }
}
