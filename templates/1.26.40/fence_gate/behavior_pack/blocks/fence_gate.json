{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:fence_gate",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "construction"
      },
      // Custom block states. The permutations below switch components on their values.
      "states": {
        "kai_templates:open": [false, true],
        "kai_templates:open_away": [false, true],
        "kai_templates:in_wall": [false, true]
      },
      // Allows the block to use exposed vanilla block states.
      "traits": {
        // Sets the enabled state from the direction the player faces when placing.
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      }
    },
    // Component overrides that apply while their Molang condition is true.
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' && !q.block_state('kai_templates:in_wall')",
        "components": {
          // Rotates, scales or offsets the geometry and boxes for this permutation.
          "minecraft:transformation": {
            "rotation": [0, 0, 0],
            "translation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south' && !q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0],
            "translation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' && !q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0],
            "translation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east' && !q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, -90, 0],
            "translation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' && q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0],
            "translation": [0, -0.1875, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south' && q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0],
            "translation": [0, -0.1875, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' && q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0],
            "translation": [0, -0.1875, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east' && q.block_state('kai_templates:in_wall')",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, -90, 0],
            "translation": [0, -0.1875, 0]
          }
        }
      },
      {
        "condition": "q.block_state('kai_templates:open')",
        "components": {
          "minecraft:collision_box": false
        }
      }
    ],
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.fence_gate.name",
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": {
        "identifier": "geometry.kai_templates_fence_gate",
        // Controls which bones are visible when the block is rendered.
        "bone_visibility": {
          "gate_closed": "!q.block_state('kai_templates:open')",
          "gate_open_forward": "q.block_state('kai_templates:open') && q.block_state('kai_templates:open_away')",
          "gate_open_backward": "q.block_state('kai_templates:open') && !q.block_state('kai_templates:open_away')"
        }
      },
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "wood_oak",
          // Controls how the block is rendered using vanilla render methods.
          "render_method": "opaque",
          // Whether neighbouring blocks darken this block's corners.
          "ambient_occlusion": 0.0
        }
      },
      // The block's collision box.
      "minecraft:collision_box": {
        "origin": [-8, 0, -2],
        "size": [16, 24, 4]
      },
      // The block's selection box.
      "minecraft:selection_box": {
        "origin": [-8, 0, -2],
        "size": [16, 16, 4]
      },
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 3,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_axe', 'minecraft:wooden_tier')"
            },
            "destroy_speed": 1.5
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_axe', 'minecraft:stone_tier')"
            },
            "destroy_speed": 0.75
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_axe', 'minecraft:iron_tier')"
            },
            "destroy_speed": 0.5
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_axe', 'minecraft:diamond_tier')"
            },
            "destroy_speed": 0.4
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_axe', 'minecraft:netherite_tier')"
            },
            "destroy_speed": 0.35
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_axe', 'minecraft:golden_tier')"
            },
            "destroy_speed": 0.25
          }
        ]
      },
      // Resistance to explosions.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 3
      },
      // How easily fire catches on and destroys the block.
      "minecraft:flammable": true,
      // Color the block shows on maps.
      "minecraft:map_color": "#8F7748",
      // How the block behaves when it detects liquids, such as waterlogging or being washed away.
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "can_contain_liquid": true,
            "on_liquid_touches": "no_reaction"
          }
        ]
      },
      // Makes the block receive redstone power and get onRedstoneUpdate events.
      "minecraft:redstone_consumer": {
        "min_power": 0,
        "propagates_power": false
      },
      // Block tags. Vanilla content and Molang queries can match on them.
      "minecraft:tags": ["minecraft:has_fence_connections"],
      // Whether blocks with connection behavior, such as fences and panes, can connect to this block.
      "minecraft:connection_rule": {
        "accepts_connections_from": "all"
      },
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:fence_gate_interact": {},
      "kai_templates:fence_gate_redstone": {},
      "kai_templates:fence_gate_in_wall": {},
      // Geometry and textures the item form shows in the inventory and in hand. Naming the block's own geometry here is what lets its item_display_transforms shape the icon.
      "minecraft:item_visual": {
        "geometry": {
          "identifier": "geometry.kai_templates_fence_gate",
          // The item has no block states for the conditions above to read, so pick the closed pose outright. Bones not listed here, the posts, stay visible.
          "bone_visibility": {
            "gate_closed": "true",
            "gate_open_forward": "false",
            "gate_open_backward": "false"
          }
        },
        "material_instances": {
          "*": {
            "texture": "wood_oak",
            "render_method": "opaque",
            "ambient_occlusion": 0.0
          }
        }
      }
    }
  }
}
