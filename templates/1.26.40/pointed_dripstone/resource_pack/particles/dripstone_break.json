{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kai_templates:dripstone_break",
      // The fragments a spike bursts into. Vanilla's block-break effect cuts
      // random four-pixel squares out of the block's texture and throws them
      // about; this does the same off the dripstone texture, since the engine
      // only plays its own effect for a block, not for an entity.
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/blocks/pointed_dripstone_down_middle"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      // One burst per spike, about what a full block scatters.
      "minecraft:emitter_rate_instant": {
        "num_particles": 24
      },
      // Spread through the cell the spike filled, thrown upward and outward.
      "minecraft:emitter_shape_box": {
        "offset": [0, 0.5, 0],
        "half_dimensions": [0.3, 0.45, 0.3],
        "direction": ["Math.random(-1, 1)", "Math.random(0.3, 1)", "Math.random(-1, 1)"]
      },
      "minecraft:particle_initial_speed": "Math.random(1, 4)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 / (Math.random(0.0, 1.0) * 0.9 + 0.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_1 * 0.0375 + 0.0375",
          "v.particle_random_1 * 0.0375 + 0.0375"
        ],
        "facing_camera_mode": "lookat_xyz",
        // A random quarter of the texture, chosen once per fragment.
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": ["math.floor(v.particle_random_2 * 4) * 4", "math.floor(v.particle_random_3 * 4) * 4"],
          "uv_size": [4, 4]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -9.8, 0],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 5,
        "coefficient_of_restitution": 0.1,
        "collision_radius": 0.1
      }
    }
  }
}
