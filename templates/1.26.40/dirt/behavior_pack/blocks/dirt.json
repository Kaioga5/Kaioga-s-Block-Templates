{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      // The ID for your custom block. Format must be namespace:block_name.
      "identifier": "kai_templates:dirt",
      // Where the block appears in the creative inventory.
      "menu_category": {
        "category": "nature"
      }
    },
    "components": {
      // Text shown for the block in the inventory and hotbar. Translated through the language files.
      "minecraft:display_name": "tile.kai_templates.dirt.name",
      // The vanilla or custom geometry used by the block.
      "minecraft:geometry": "minecraft:geometry.full_block",
      // The texture or textures used by the block.
      "minecraft:material_instances": {
        "*": {
          "texture": "flattened_dirt",
          // Randomly rotates the texture per block to hide tiling.
          "isotropic": true
        }
      },
      // How much light the block stops. 0 lets light through, 15 blocks it fully.
      "minecraft:light_dampening": 15,
      // Break time in seconds, with faster speeds for specific tools.
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.75,
        "item_specific_speeds": [
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_shovel', 'minecraft:wooden_tier')"
            },
            "destroy_speed": 0.4
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_shovel', 'minecraft:stone_tier')"
            },
            "destroy_speed": 0.2
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_shovel', 'minecraft:iron_tier')"
            },
            "destroy_speed": 0.15
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_shovel', 'minecraft:diamond_tier')"
            },
            "destroy_speed": 0.1
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_shovel', 'minecraft:netherite_tier')"
            },
            "destroy_speed": 0.1
          },
          {
            "item": {
              "tags": "q.all_tags('minecraft:is_shovel', 'minecraft:golden_tier')"
            },
            "destroy_speed": 0.1
          }
        ]
      },
      // Resistance to explosions.
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.5
      },
      // Whether the block carries redstone power like a solid block.
      "minecraft:redstone_conductivity": {
        "redstone_conductor": true
      },
      // Color the block shows on maps.
      "minecraft:map_color": "#976D4D",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:dirt_spread": {},
      // Block tags. Vanilla content and Molang queries can match on them.
      "minecraft:tags": [
        "minecraft:is_shovel_item_destructible",
        "kai_templates:flower_support"
      ]
    }
  }
}
