        "destroy_chance_modifier": 20
      },
      // The instrument a note block plays when it sits on this block.
      "minecraft:instrument_sound": {
        "up": "note.bassattack"
      },
      // Makes the block output a redstone signal.
      "minecraft:redstone_producer": {
        "power": 0
      },
      // Whether the block carries redstone power like a solid block.
      "minecraft:redstone_conductivity": {
        "redstone_conductor": true
      },
      // How pistons can move the block.
      "minecraft:movable": {
        "movement_type": "push_pull"
      },
      // Loot table used when the block is broken. Without it the block drops itself.
      "minecraft:loot": "loot_tables/blocks/jukebox.json",
      // Custom components are registered by the scripts in behavior_pack/scripts.
      "kai_templates:jukebox_slot": {}
